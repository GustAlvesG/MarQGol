# MarQGol — desenvolvimento. Copie para .env.
# Banco: rode `npm run db` num terminal (Postgres embutido na porta 5433).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/marqgol
PORT=4000

# Seu acesso ao painel de gestão (/admin), criado na primeira subida.
SUPERADMIN_EMAIL=dono@exemplo.com
SUPERADMIN_SENHA=troque-esta-senha

