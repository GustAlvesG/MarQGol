# MarQGol — variáveis de produção (copie para .env na VPS; o script `site`
# gera as que estão em SECRET_VARS se ficarem vazias).

# Subdomínio público (registro A na Hostinger apontando para a VPS).
DOMAIN=marqgol.artzan.tech

# Senha do Postgres (gerada pelo script se vazia; só hex).
DB_PASSWORD=

# Segredo das sessões de login (gerado pelo script se vazio).
SESSION_SECRET=

# Seu acesso ao painel de gestão (/admin). Criado no primeiro migrate.
# A senha é gerada pelo script se ficar vazia — leia-a depois no .env.
SUPERADMIN_EMAIL=
SUPERADMIN_SENHA=

# Asaas (cobrança). Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token que o Asaas manda no cabeçalho asaas-access-token do webhook. Cadastre
# no painel do Asaas o webhook https://<DOMAIN>/api/asaas/webhook com este token.
ASAAS_WEBHOOK_TOKEN=

# E-mail (SMTP). Sem SMTP_HOST os e-mails só aparecem no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MarQGol <nao-responda@marqgol.artzan.tech>

# Tamanho máximo de UM arquivo enviado (MB). A cota total vem do plano.
MAX_UPLOAD_MB=500
